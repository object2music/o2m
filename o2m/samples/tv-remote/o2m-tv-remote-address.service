[Unit]
Description=o2m TV remote: Bluetooth LE only, on its own address
# bthelper writes the Pi's factory address; this runs after it and before
# bluetoothd, whose ATT server listens on the address it finds at start.
After=bthelper@hci0.service sys-subsystem-bluetooth-devices-hci0.device
Requires=sys-subsystem-bluetooth-devices-hci0.device
Before=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The address the box was paired with. Change it and the box must pair again.
Environment=O2M_REMOTE_ADDR=B8:27:EB:A1:02:03
ExecStart=/usr/bin/btmgmt power off
ExecStart=/usr/bin/btmgmt bredr off
ExecStart=/usr/bin/btmgmt public-addr ${O2M_REMOTE_ADDR}

[Install]
WantedBy=bluetooth.service
