[Unit]
Description=o2m TV remote: the Pi as a Bluetooth LE remote that wakes the TV box
After=bluetooth.service o2m-tv-remote-address.service
Requires=bluetooth.service
PartOf=bluetooth.service

[Service]
ExecStart=/usr/bin/python3 -u /home/pi/o2m/o2m/samples/tv-remote/o2m-tv-remote.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
