######################## Frontend ########################
PUBLIC_POCKETBASE_URL=http://localhost:8090

######################## Instance identity ########################
# Canonical public HTTPS URL of THIS instance (served by Caddy + basic-auth).
# Every public-facing URL (Spotify redirect, backoffice…) derives from it.
# Replace XX with this instance's host. The host<->instance assignment lives in the
# internal deployment reference (not committed).
O2M_PUBLIC_URL=https://XX.o2m.site

######################## Ports ########################
# Each instance owns a contiguous port block. The absolute base is assigned per
# instance (internal deployment reference, not committed). Offsets are fixed —
# here XX is the per-instance prefix, the trailing digit is the offset:
PORT_MOPIDY=XX0           # +0
PORT_O2M_API=XX1          # +1
PORT_SNAPSERVER_HTTP=XX2  # +2
PORT_SNAPSERVER_1=XX3     # +3
PORT_SNAPSERVER_2=XX4     # +4
PORT_MPD=XX5              # +5
PORT_MYSQL=XX6            # +6
PORT_PHPMYADMIN=XX7       # +7

# Internal addressing: containers reach each other by Docker SERVICE NAME on the
# compose network — NEVER a LAN or public IP.
HOST_MOPIDY=mopidy

######################## Mopidy ########################
# Logging
LOGGING_CONFIG_FILE=/etc/mopidy/logging.conf
LOGGING_DEBUG_FILE=/var/log/mopidy/mopidy-debug.log

# Audio (single line — do not wrap)
AUDIO_OUTPUT=audioconvert ! audio/x-raw,rate=48000,channels=2,format=S16LE ! wavenc ! filesink location=/tmp/snapfifo

# Spotify — app used by mopidy-spotify for metadata (client_credentials) and as the
# librespot identity. SPOTIFY_USERNAME is the Spotify account id (also the default
# edit-auth allowlist entry). NOTE: SPOTIFY_PASSWORD is deprecated in mopidy-spotify
# 5.x and intentionally NOT used — do not add it.
SPOTIFY_USERNAME=xxx
SPOTIFY_CLIENT_ID=xxx
SPOTIFY_CLIENT_SECRET=xxx

# Spotipy — app behind the UNIFIED OAuth (Web API + streaming + edit identity).
# The redirect must also be registered in this app's Spotify dashboard.
SPOTIPY_CLIENT_ID=xxx
SPOTIPY_CLIENT_SECRET=xxx
SPOTIPY_REDIRECT_URI=${O2M_PUBLIC_URL}/api/spotipy_init

# Last.fm — mood/energy/valence + genre enrichment (optional; only some instances).
LASTFM_API_KEY=xxx

# HTTP
HTTP_ENABLED=true
HTTP_HOSTNAME=::
HTTP_PORT=6680
ALLOWED_ORIGINS=localhost:5173
CSRF_PROTECTION=false

# MPD
MPD_HOSTNAME=::

# File
FILE_ENABLED=true
FILE_MEDIA_DIRS=/app/Music

# Local
LOCAL_ENABLED=true
LOCAL_MEDIA_DIR=/app/Music

# YouTube
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=xxx
YOUTUBE_API_ENABLED=true
YOUTUBE_DL_PACKAGE=yt_dlp

# Podcast
PODCAST_ENABLED=true
PODCAST_BROWSE_ROOT=/etc/mopidy/podcast/Podcasts.opml

# Scrobbler
SCROBBLER_USERNAME=xxx
SCROBBLER_PASSWORD=xxx

# Beets
BEETS_ENABLED=false
BEETS_HOSTNAME=127.0.0.1
BEETS_PORT=8337

# IRControl
IRCONTROL_ENABLED=true
IRCONTROL_MUTE=KEY_MUTE
IRCONTROL_NEXT=KEY_NEXT
IRCONTROL_PREVIOUS=KEY_PREVIOUS
IRCONTROL_PLAYPAUSE=KEY_PLAYPAUSE
IRCONTROL_STOP=KEY_STOP
IRCONTROL_VOLUMEUP=KEY_VOLUMEUP
IRCONTROL_VOLUMEDOWN=KEY_VOLUMEDOWN


######################## o2m ########################
O2M_DISCOVER=false
O2M_API_RESULT_LIMIT=30
O2M_SHUFFLE=false
O2M_DEFAULT_VOLUME=70
# Per-instance tuning (kept distinct across instances on purpose)
O2M_DISCOVER_LEVEL=5
O2M_OPTION_AUTOFILL_PLAYLISTS=true
O2M_OPTION_ADD_RECO_AFTER_TRACK=true
O2M_PODCAST_NEWEST_FIRST=false
# Spotify account ids allowed to edit (csv); defaults to SPOTIFY_USERNAME if empty.
O2M_EDIT_SPOTIFY_IDS=
# Default box auto-activated at startup (optional).
O2M_DEFAULT_BOX_UID=
# Backoffice (phpMyAdmin): HTTPS Caddy route, never a public IP:port.
O2M_BACKOFFICE_URI=https:\/\/pmaXX.o2m.site
O2M_FIX_STATS=False

# Database — DB_HOST is the Docker service name (never an IP). DB creds are baked into
# the instance's MySQL volume at first init; don't change them on a live instance.
DB_TYPE=mysql
DB_USERNAME=o2m
DB_PASSWORD=o2m
DB_HOST=mysql
DB_PORT=3306
DB_NAME=o2m

# Alternative for SQLite
# DB_TYPE=sqlite
# DB_SQLITE_PATH=data.db

######################## spotdl cache ########################
# Hour (0-23) to run the daily download job
SPOTDL_CACHE_HOUR=3
# Days before a cached file is considered stale and deleted
SPOTDL_CACHE_DAYS=30
# Comma-separated box UIDs to cache; empty = all pinned boxes
SPOTDL_BOX_UIDS=
# Mopidy music dir as seen inside the mopidy container (must match FILE_MEDIA_DIRS)
MOPIDY_MUSIC_DIR=/app/Music
# Mount point of the music dir inside the spotdl container
SPOTDL_MUSIC_MOUNT=/music
