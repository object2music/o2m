# O2M mopidy image, Mopidy 4 candidate (spike).
#
# Base is Debian trixie, not Ubuntu 22.04: Mopidy 4 needs Python >= 3.13, and
# trixie ships 3.13.5 with python3-gi 3.50 (mopidy 4 requires pygobject >= 3.50)
# and GStreamer 1.26. apt.mopidy.com serves only Mopidy 3.4.2 on every suite, so
# Mopidy itself comes from pip; the repo is still used for gst-plugin-spotify,
# which replaces the hand-pinned .deb from a GitHub release.
#
# Iris is deliberately NOT installed: the UI is o2m's own. That also removes the
# o2m.js / o2m.css / index.html / app.js copies into mopidy_iris/static and the
# sed rewrites in the entrypoint.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

RUN apt-get -qq update && apt-get -qq install -y --no-install-recommends \
      python3 python3-pip python3-gi python3-gst-1.0 \
      gir1.2-gstreamer-1.0 gir1.2-gst-plugins-base-1.0 \
      gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
      gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-tools \
      curl wget ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/apt/keyrings \
    && wget -q -O /etc/apt/keyrings/mopidy-archive-keyring.gpg https://apt.mopidy.com/mopidy.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/mopidy-archive-keyring.gpg] https://apt.mopidy.com/ trixie main contrib non-free" \
       > /etc/apt/sources.list.d/mopidy.list \
    && apt-get -qq update && apt-get -qq install -y --no-install-recommends gst-plugin-spotify \
    && rm -rf /var/lib/apt/lists/*

# setuptools < 81 on purpose: Mopidy-YouTube and Mopidy-TuneIn still
# `import pkg_resources`, which setuptools 81 removed. Without the pin both
# extensions fail to load with ModuleNotFoundError.
RUN pip install --break-system-packages --root-user-action=ignore -q "setuptools<81"

RUN pip install --break-system-packages --root-user-action=ignore -q \
      mopidy==4.0.3 \
      Mopidy-Spotify==5.0.0 \
      Mopidy-MPD Mopidy-Local Mopidy-Podcast Mopidy-Podcast-iTunes \
      Mopidy-YouTube Mopidy-TuneIn

# o2m's own python deps (from mopidy/requirements.txt, minus the mopidy
# extensions installed above and minus Iris).
RUN pip install --break-system-packages --root-user-action=ignore -q \
      spotipy requests mock six yt_dlp mopidyapi \
      peewee PyMysql numpy flask flask_cors flask_session mysql-connector-python

# Compat shim: `mopidy.internal` was removed in Mopidy 4, but Mopidy-TuneIn
# (1.1.0, 2021, unmaintained) imports http + playlists from it. Vendored
# verbatim from Mopidy 3.4.2; self-contained apart from mopidy.httpclient,
# which still exists in 4.
COPY ./compat_internal /usr/local/lib/python3.13/dist-packages/mopidy/internal

WORKDIR /app
COPY ./mopidy-o2m /app/mopidy-o2m
# The plugin declares `mopidy >= 3.4` with no upper bound, precisely so this
# install cannot drag mopidy backwards. It previously pinned `< 4`, which pip
# honoured here by silently DOWNGRADING mopidy 4.0.3 to 3.4.2 and leaving every
# other extension unsatisfied — a build that succeeds and a stack that is
# quietly wrong. If you ever re-add an upper bound, this line needs --no-deps.
RUN pip install --break-system-packages --root-user-action=ignore -q /app/mopidy-o2m

COPY ./entrypoint4.sh ./create_conf_files4.sh /app/
RUN chmod +x /app/entrypoint4.sh /app/create_conf_files4.sh && mkdir -p /etc/mopidy

ENTRYPOINT ["/app/entrypoint4.sh"]
